# Solana RPC endpoint
# Devnet (default):
VITE_SOLANA_ENDPOINT=https://api.devnet.solana.com
# Localnet (development):
# VITE_SOLANA_ENDPOINT=http://127.0.0.1:8899
# Private RPC with WebSocket support (recommended for live events):
# VITE_SOLANA_ENDPOINT=https://your-endpoint.helius-rpc.com/?api-key=YOUR_KEY
